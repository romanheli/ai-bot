# скопируй в .env и заполни
BOT_TOKEN=токен основного бота от @BotFather
LOG_BOT_TOKEN=токен лог-бота от @BotFather
ADMIN_ID=твой Telegram id (туда лог-бот шлёт вопросы)
ALLOWED_IDS=id через запятую, кому можно пользоваться ботом
GEMINI_API_KEY=ключ из Google AI Studio
CREATOR_USERNAME=username создателя без @ (для ссылки на профиль в меню)
# необязательно: имя создателя в меню, по умолчанию @username
# CREATOR_NAME=имя создателя
# необязательно: своя цепочка моделей через запятую
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
